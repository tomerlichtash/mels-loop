# Copy to apps/web/.env and fill in what you need.
#
# Everything here is optional for local development — the site builds and runs
# with none of it set. Each variable degrades in a specific way, noted below.

# ---- Media ----------------------------------------------------------------
# Where /media/* paths resolve to. Unset, media paths stay relative and are
# served from apps/web/public/media (which is gitignored — see scripts/README
# for pulling assets down with `pnpm media:clone`).
AWS_BUCKET="mels-loop-media"
AWS_REGION="eu-north-1"

# ---- Site -----------------------------------------------------------------
# Absolute base URL used for canonical links and sitemap entries.
# Defaults to https://melsloop.com when unset.
SITE_URL="http://localhost:3000"

# ---- Analytics ------------------------------------------------------------
# Google Analytics measurement ID. Unset, no analytics script is injected.
NEXT_PUBLIC_ANALYTICS_ID=""

# ---- Auth (Clerk) ---------------------------------------------------------
# Clerk only wires up when the publishable key is present. With REQUIRE_AUTH
# set to true, auth.protect() gates the entire site — this is how the staging
# deployment is kept private, and it makes every route 404 to signed-out
# visitors, including robots.txt.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
REQUIRE_AUTH="false"

# ---- Contact form ---------------------------------------------------------
# The /api/sendgrid route calls the SendGrid REST API directly; there is no
# SDK dependency. Unset, the contact form fails on submit.
SENDGRID_API_KEY=""
SENDGRID_TO_EMAIL="about@melsloop.com"
SENDGRID_FROM_EMAIL="noreply@melsloop.com"

# ---- Turnstile (contact form captcha) -------------------------------------
# These are Cloudflare's public always-pass test keys, safe to commit and
# fine for local development. Replace with real keys in deployed environments.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
