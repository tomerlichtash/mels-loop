# Copy to apps/web/.env and fill in what you need.
#
# Everything here is optional for local development — the site builds and runs
# with none of it set. Each variable degrades in a specific way, noted below.

# ---- Media ----------------------------------------------------------------
# Where /media/* paths resolve to. Unset, media paths stay relative and are
# served from apps/web/public/media (which is gitignored — see scripts/README
# for pulling assets down with `pnpm media:clone`).
AWS_BUCKET="mels-loop-media"
AWS_REGION="eu-north-1"

# ---- Site -----------------------------------------------------------------
# Absolute base URL used for canonical links and sitemap entries.
# Defaults to https://melsloop.com when unset.
SITE_URL="http://localhost:3000"

# ---- Analytics ------------------------------------------------------------
# Google Analytics measurement ID. Unset, no analytics script is injected.
NEXT_PUBLIC_ANALYTICS_ID=""

# ---- Contact form (Postmark) ----------------------------------------------
# The /api/contact route calls Postmark's REST API directly; there is no SDK
# dependency. The token must be a *Server* token — an Account token manages
# domains and signatures and cannot send.
#
# Unset in development the route logs the submission and reports success, so
# the form can be exercised end to end. Unset in production it fails loudly,
# because there a missing token is a misconfiguration rather than a no-op.
#
# The From address must sit on a domain verified in Postmark. melsloop.com is:
# DKIM, Return-Path, SPF and DMARC are all live.
POSTMARK_SERVER_TOKEN=""
CONTACT_TO_EMAIL="about@melsloop.com"
CONTACT_FROM_EMAIL="noreply@melsloop.com"
