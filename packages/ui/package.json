{
	"name": "@mels-loop/ui",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node scripts/build.js",
		"type-check": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test-storybook": "test-storybook",
		"test-storybook:ci": "test-storybook --url http://127.0.0.1:6006",
		"test:e2e": "sh scripts/docker-e2e.sh",
		"test:e2e:update": "sh scripts/docker-e2e.sh --update-snapshots",
		"test:e2e:ui": "playwright test --config playwright.config.ts --ui",
		"test:e2e:ui:debug": "playwright test --config playwright.config.ts --ui --debug"
	},
	"exports": {
		"./styles/globals.css": "./dist/styles/globals.css",
		"./styles/tokens": "./dist/styles/tokens/index.css",
		"./styles/tokens/media.css": "./dist/styles/tokens/media.css",
		"./primitives": {
			"types": "./dist/primitives/index.d.ts",
			"import": "./dist/primitives/index.js"
		},
		"./color-scheme": {
			"types": "./dist/color-scheme/index.d.ts",
			"import": "./dist/color-scheme/index.js"
		}
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-dialog": "^1.1.4",
		"@radix-ui/react-popover": "^1.1.4",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-toggle": "^1.1.10",
		"@radix-ui/react-toggle-group": "^1.1.11",
		"@radix-ui/react-tooltip": "^1.2.8",
		"classnames": "^2.5.1"
	},
	"devDependencies": {
		"@csstools/postcss-global-data": "^4.0.0",
		"@mels-loop/eslint-config": "workspace:*",
		"@radix-ui/react-icons": "^1.3.2",
		"@storybook/addon-essentials": "^8",
		"@storybook/react": "^8.6.17",
		"@storybook/react-vite": "^8.6.17",
		"@storybook/test-runner": "^0.22.1",
		"@vitejs/plugin-react": "^5.1.4",
		"postcss-custom-media": "^12.0.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"storybook": "^8.6.17",
		"vite": "^7.3.1"
	}
}
