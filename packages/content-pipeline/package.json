{
	"name": "@mels-loop/content-pipeline",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"type-check": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"exports": {
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		},
		"./markdown": {
			"types": "./dist/markdown/pipeline.d.ts",
			"import": "./dist/markdown/pipeline.js"
		},
		"./loaders": {
			"types": "./dist/loaders/index.d.ts",
			"import": "./dist/loaders/index.js"
		}
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"rehype-raw": "^7.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5"
	},
	"devDependencies": {
		"@mels-loop/eslint-config": "workspace:*",
		"@types/hast": "^3.0.4"
	}
}
