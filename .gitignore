# dependencies
node_modules
/.pnp
.pnp.js

# artifacts
dist/
**/*.js.map

# dev env
.vscode/settings.json
*.tsbuildinfo

# testing
coverage/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
*.env.*
.env.local
.env.development
.env.test
.env.development.local
.env.test.local
.env.production.local
.vercel

test-results/
results.xml
unit-tests.xml
temp/

.turbo
.next

storybook-static

.playwright-mcp

# ui e2e testing
packages/ui/test-results/
packages/ui/playwright-report/
packages/ui/__snapshots__/local/

# search index (generated)
apps/web/public/search-index.*.json

# local media (test before S3 upload)
apps/web/public/media/*
!apps/web/public/media/.gitkeep
# Next.js generates this on every build; prettier rewrites its quote style,
# producing endless churn. Regenerated automatically — no need to track it.
next-env.d.ts
