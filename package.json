{
	"name": "mels-loop",
	"version": "2.0.0",
	"private": true,
	"packageManager": "pnpm@10.29.2",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"type-check": "turbo type-check",
		"lint": "turbo lint",
		"lint:fix": "turbo lint:fix",
		"test": "turbo test --log-order grouped",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"media:upload": "pnpm --filter @mels-loop/scripts s3:upload",
		"media:clone": "pnpm --filter @mels-loop/scripts s3:clone",
		"media:download": "pnpm --filter @mels-loop/scripts s3:download",
		"media:delete": "pnpm --filter @mels-loop/scripts s3:delete",
		"media:list": "pnpm --filter @mels-loop/scripts s3:list",
		"prepare": "husky",
		"test:e2e": "turbo test:e2e"
	},
	"lint-staged": {
		"*.{js,mjs,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{css,json}": "prettier --write"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@mels-loop/eslint-config": "workspace:*",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"@types/node": "^25.2.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.27.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.1",
		"postcss": "^8.5.6",
		"postcss-custom-media": "^12.0.0",
		"prettier": "^3.5.3",
		"tsx": "^4.21.0",
		"turbo": "^2.5.0",
		"typescript": "^5.9.3"
	}
}
