{
	"name": "mels-loop",
	"version": "2.0.0",
	"private": true,
	"packageManager": "pnpm@10.29.2",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "turbo lint",
		"test": "turbo test:e2e",
		"test:e2e": "turbo test:e2e",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,mjs,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{css,json}": "prettier --write"
	},
	"devDependencies": {
		"@mels-loop/eslint-config": "workspace:*",
		"@playwright/test": "^1.51.1",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"@types/node": "^25.2.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"eslint": "^9.27.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.1",
		"postcss": "^8.5.6",
		"postcss-custom-media": "^12.0.0",
		"prettier": "^3.5.3",
		"tsx": "^4.21.0",
		"turbo": "^2.5.0",
		"typescript": "^5.9.3"
	}
}
